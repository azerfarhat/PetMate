# ==============================================================================
# PAWMATE BACKEND - EXAMPLE ENVIRONMENT VARIABLES
# Copier ce fichier vers `.env` puis remplacer les valeurs par les vraies.
# Ne jamais committer le fichier `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pawmate
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------------------
# JWT - RS256 (clés PEM encodées PKCS8/X509)
# Génération (openssl) :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
PASTE_YOUR_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
PASTE_YOUR_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# Durée de vie en SECONDES
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=604800
JWT_REFRESH_TOKEN_REMEMBER_ME_EXPIRATION=2592000

# ------------------------------------------------------------------------------
# MAIL (SMTP transactionnel - emails de vérification)
# Exemple local : MailHog sur le port 1025 (http://localhost:8025 pour la UI)
# ------------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@pawmate.app
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ---- PRODUCTION (un fournisseur SMTP transactionnel - Brevo, SendGrid, Postmark, AWS SES...)
# Exemple Brevo :
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=ton_login_smtp_brevo
# MAIL_PASSWORD=ton_cle_secrete
# MAIL_FROM=noreply@pawmate.app         (domaine vérifié + SPF/DKIM configurés)
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# Ne jamais commit .env : en CI/prod, passer ces valeurs via l'orchestrateur.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# EMAIL DE VÉRIFICATION
# ------------------------------------------------------------------------------
# URL de base publique pour construire le lien de vérification (backend accessible
# depuis le client mobile / navigateur).
APP_BASE_URL=http://localhost:8080
# Schéma de deep-link mobile (ex. "pawmate"). Renseigné = liens type pawmate://verify
# pour ouvrir l'app mobile au lieu d'une URL web. Vide = lien web classique.
APP_DEEP_LINK_SCHEME=
# Hôte du deep-link mobile (route gérée par l'app). Par défaut "verify".
APP_DEEP_LINK_HOST=verify
# Durée de validité d'un jeton de vérification, en MINUTES
VERIFICATION_TOKEN_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# RATE-LIMIT INSCRIPTION (anti-spam de faux comptes, par IP)
# ------------------------------------------------------------------------------
# Nombre maximal de créations de compte autorisé par IP sur la fenêtre glissante.
REGISTER_MAX_PER_WINDOW=5
# Durée de la fenêtre glissante pour l'inscription, en MINUTES.
REGISTER_WINDOW_MINUTES=60

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
SERVER_PORT=8080