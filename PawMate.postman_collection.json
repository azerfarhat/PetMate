{
  "info": {
    "name": "PawMate",
    "description": "API PawMate — Backend Spring Boot. Collection complète et organisée.\n\nWorkflow :\n1. Auth > Register → 201\n2. Auth > Verify Code → 200\n3. Auth > Login → 200 (script sauvegarde accessToken + refreshToken)\n4. Tester chaque module (Users, Pets, Match, Conversations, Notifications)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/register",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Dupont\",\n  \"email\": \"{{REGISTER_EMAIL}}\",\n  \"password\": \"{{PASSWORD}}\",\n  \"bio\": \"Passionné de chiens\",\n  \"latitude\": 48.8566,\n  \"longitude\": 2.3522,\n  \"searchRadius\": 10,\n  \"pets\": [\n    {\n      \"name\": \"Rex\",\n      \"type\": \"DOG\",\n      \"breed\": \"Labrador\",\n      \"gender\": \"MALE\",\n      \"age\": 3,\n      \"energyLevel\": \"HIGH\",\n      \"description\": \"Très joueur\",\n      \"vaccinated\": true,\n      \"neutered\": true\n    }\n  ]\n}"
            },
            "description": "Crée un compte Owner (User + 1..* Pets).\nPOST 201 : compte créé + email envoyé.\nPOST 400 : validation.\nPOST 409 : email déjà utilisé. Rate-limit : 5 / 60 min → 429."
          },
          "response": []
        },
        {
          "name": "2. Verify Email (GET lien)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/verify-email?token={{VERIFY_TOKEN}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{VERIFY_TOKEN}}"
                }
              ]
            },
            "description": "Vérifie l'email via le lien reçu. GET 200 : vérifié. GET 400 : token invalide/expiré."
          },
          "response": []
        },
        {
          "name": "2b. Verify Code (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/verify-code",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "verify-code"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{VERIFY_CODE}}\"\n}"
            },
            "description": "Vérifie l'email avec le code 6 chiffres. POST 200 : vérifié. POST 400 : code invalide."
          },
          "response": []
        },
        {
          "name": "3. Resend Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/resend-verification",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "resend-verification"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{EMAIL}}\"\n}"
            },
            "description": "Renvoie l'email de vérification (ancien token invalidé). 200/404/400."
          },
          "response": []
        },
        {
          "name": "4. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{EMAIL}}\",\n  \"password\": \"{{PASSWORD}}\",\n  \"rememberMe\": false\n}"
            },
            "description": "Connexion. Sauvegarde accessToken + refreshToken automatiquement.\nAuth brute-force : 5 échecs → 429 pendant 5 min.\nrememberMe=true → refresh 30 j, sinon 7 j.",
            "event": [
              {
                "listen": "test",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) { pm.environment.set('accessToken', json.accessToken); }",
                  "if (json.refreshToken) { pm.environment.set('refreshToken', json.refreshToken); }"
                ]
              }
            ]
          },
          "response": []
        },
        {
          "name": "5. Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/refresh",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Rotation du refresh token (ancien révoqué, nouveau couple retourné).",
            "event": [
              {
                "listen": "test",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) { pm.environment.set('accessToken', json.accessToken); }",
                  "if (json.refreshToken) { pm.environment.set('refreshToken', json.refreshToken); }"
                ]
              }
            ]
          },
          "response": []
        },
        {
          "name": "6. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/logout",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Révoque le refresh token courant, idempotent."
          },
          "response": []
        },
        {
          "name": "7. Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/forgot-password",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{EMAIL}}\"\n}"
            },
            "description": "Envoie le lien de réinitialisation (pawmate://verify/reset). Réponse générique."
          },
          "response": []
        },
        {
          "name": "8. Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/reset-password",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{RESET_TOKEN}}\",\n  \"newPassword\": \"{{NEW_PASSWORD}}\"\n}"
            },
            "description": "Réinitialise le mot de passe (jeton valide 30 min, usage unique)."
          },
          "response": []
        }
      ]
    },
