    {
      "name": "4. Matching / Swipe (Bearer)",
      "item": [
        {
          "name": "GET /match/candidates (feed de découverte)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Candidats OK\", function () { pm.response.to.have.status(200); });",
                  "const candidates = pm.response.json();",
                  "if (Array.isArray(candidates) && candidates.length > 0) {",
                  "  pm.collectionVariables.set('targetPetId', String(candidates[0].petId));",
                  "  if (!pm.collectionVariables.get('otherUserId')) {",
                  "    pm.collectionVariables.set('otherUserId', String(candidates[0].owner.id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/match/candidates?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["match", "candidates"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /match/swipe (LIKE / PASS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Swipe OK\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.matched) {",
                  "  pm.collectionVariables.set('matchId', String(data.matchId));",
                  "  pm.collectionVariables.set('conversationId', String(data.conversationId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/match/swipe",
              "host": ["{{baseUrl}}"],
              "path": ["match", "swipe"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"LIKE\",\n  \"targetPetId\": {{targetPetId}}\n}"
            }
          },
          "response": []
        },
        {
          "name": "GET /match (mes matchs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Matchs OK\", function () { pm.response.to.have.status(200); });",
                  "const matches = pm.response.json();",
                  "if (Array.isArray(matches) && matches.length > 0) {",
                  "  pm.collectionVariables.set('matchId', String(matches[0].matchId));",
                  "  pm.collectionVariables.set('conversationId', String(matches[0].conversationId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/match",
              "host": ["{{baseUrl}}"],
              "path": ["match"]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /match/{matchId} (unmatch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unmatch OK\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
